# Relaxed yamllint config for CI — focuses on real errors, not cosmetics.
extends: relaxed

rules:
  line-length: disable
  document-start: disable
  comments:
    min-spaces-from-content: 1
  truthy:
    # GitHub Actions uses `on:` as a key — don't flag it as a boolean.
    allowed-values: ['true', 'false', 'on', 'off']
    check-keys: false
  indentation:
    spaces: consistent
    indent-sequences: whatever